{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Art Agent",
  "version": "0.1.0",
  "identifier": "com.aiartagent.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm.cmd run dev",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop-assets.ps1"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Art Agent",
        "width": 1280,
        "height": 820,
        "minWidth": 1200,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http: https: data:; connect-src 'self' http: https: ws: wss:; frame-src http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../backend/dist/ai-art-agent-backend.exe": "backend/ai-art-agent-backend.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
